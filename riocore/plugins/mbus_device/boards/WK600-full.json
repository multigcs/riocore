{
  "comment": "CNWeiken WK600 VFD",
  "address": 1,
  "timeout": 100,
  "delay": 60,
  "pins": {
    "MODBUS": {"direction": "output", "edge": "target", "pos": [15, 110], "type": ["MODBUS"], "bus": true},
    "MODBUS:OUT": {"direction": "output", "edge": "source", "pos": [15, 130], "type": ["PASSTHROUGH"], "bus": true, "pintype": "PASSTHROUGH", "source": "MODBUS"}
  },
  "commands": {
    "set_speed": {
        "type": 6,
        "register": 4096,
        "priority": 9,
        "values": 1,
        "datatype": "int",
        "scale": 100,
        "unit": "%",
        "format": "0.2f",
        "error_values": "0",
        "direction": "output"
    },
    "mode": {
        "type": 6,
        "register": 8192,
        "priority": 5,
        "values": 1,
        "datatype": "int",
        "direction": "output",
        "signals": {
            "vfd_command_on": {
                "net": "spindle.0.on"
            },
            "vfd_command_fwd": {
                "net": "spindle.0.forward"
            },
            "vfd_command_rev": {
                "net": "spindle.0.reverse"
            }
        },
        "error_values": "5",
        "cmdmapping": "!on:5, fwd:1, rev:2"
    },
    "output_voltage": {
        "type": 3,
        "register": 28675,
        "priority": 1,
        "values": 1,
        "datatype": "int",
        "scale": 1.0,
        "unit": "V",
        "format": "d",
        "direction": "input"
    },
    "output_current": {
        "type": 3,
        "register": 28676,
        "priority": 1,
        "values": 1,
        "datatype": "int",
        "scale": 0.01,
        "unit": "A",
        "format": "0.2f",
        "direction": "input"
    },
    "output_power": {
        "type": 3,
        "register": 28677,
        "priority": 1,
        "values": 1,
        "datatype": "int",
        "scale": 100,
        "unit": "W",
        "format": "0.1f",
        "direction": "input"
    },
    "commanded_speed": {
        "type": 3,
        "register": 28700,
        "priority": 9,
        "values": 1,
        "datatype": "int",
        "scale": 0.01,
        "unit": "%",
        "format": "0.2f",
        "direction": "input"
    },
    "fault_condition": {
        "type": 3,
        "register": 28734,
        "priority": 5,
        "values": 1,
        "datatype": "int",
        "scale": 1.0,
        "format": "d",
        "direction": "input"
    }
  }
}
