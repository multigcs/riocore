            "source": "\n#include \"rio.h\"\n\nint main() {\n    sysinit();\n\n    pinMode(GPIO_LED0, OUTPUT);\n    pinMode(GPIO_LED1, OUTPUT);\n    digitalWrite(GPIO_LED0, HIGH);\n    digitalWrite(GPIO_LED1, LOW);\n\n    uint32_t last = mills();\n    while (1) {\n        uint32_t now = mills();\n        if (now - last > 100) {\n            last = now;\n            digitalWrite(GPIO_LED0, TOGGLE);\n            digitalWrite(GPIO_LED1, TOGGLE);\n        }\n\n        RIO_IN = RIO_OUT / 2;\n    }\n\n    return 0;\n}\n"
